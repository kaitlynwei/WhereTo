VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Private server-only OpenAI configuration. Never use a VITE_ prefix here.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Local server defaults. Set WHERETO_API_HOST=0.0.0.0 on most hosting platforms.
NODE_ENV=development
WHERETO_API_HOST=127.0.0.1
WHERETO_API_PORT=8787
WHERETO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WHERETO_TRUST_PROXY=false
WHERETO_REQUEST_BODY_LIMIT_BYTES=32768
WHERETO_RATE_LIMIT_MAX=20
WHERETO_RATE_LIMIT_WINDOW_MS=60000
WHERETO_AI_TIMEOUT_MS=30000
WHERETO_PRICE_LOOKUP_TIMEOUT_MS=8000
WHERETO_PRICE_CACHE_TTL_MS=43200000
