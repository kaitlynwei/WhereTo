{
  "name": "whereto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --env-file=.env --watch server/index.js",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "node --test test/*.test.js",
    "test:auth": "firebase emulators:exec --only auth --project whereto-auth-test \"node --test test/firebase-auth.emulator.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore --project whereto-rules-test \"node --test test/firestore.rules.emulator.mjs\"",
    "test:all": "npm run test:unit && npm run test:auth && npm run test:rules"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "firebase": "^12.19.0",
    "lucide-react": "latest",
    "openai": "^7.23.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.32.1"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
